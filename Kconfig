source "Kconfig.zephyr"

config TOP_SHELL
    bool "Enable top-like screen in shell"
    depends on SHELL
    default y

config RDD2_RC_SYNAPSE
    bool "RC from the ManualControl topic over the serial transport"
    depends on RDD2_ZROS_SERIAL
    depends on INPUT
    help
      Accept ManualControlData frames on the synapse serial link and
      replay them as input events on the cognipilot,synapse-rc device
      named by the rc alias. This is the RC path for a ground station
      link (e.g. WiFi through a UART bridge) with no hardware receiver;
      rc_input.c and the arming/staleness logic are unchanged. The RC
      failsafe is the existing staleness timeout, so the ground station
      must send at a fixed cadence.

config RDD2_IMU_TRIGGER
    bool "Data-ready trigger IMU acquisition"
    depends on SENSOR
    help
      Pace the control loop from the IMU's data-ready trigger through the
      classic fetch/get sensor API, for IMU drivers without sensor
      streaming (RTIO) support such as the BMI270. The trigger handler
      reads the sample in driver context and queues it for the control
      thread.

config RDD2_IMU_TRIGGER_ODR_HZ
    int "IMU output data rate for the trigger backend in Hz"
    depends on RDD2_IMU_TRIGGER
    default 800
    help
      Requested accelerometer and gyroscope sampling frequency. The
      data-ready rate is the control loop rate. Drivers that do not
      accept the request keep their default rate; the loop adapts via
      measured dt either way.
    
menu "RDD2"

rsource "subsys/Kconfig"
rsource "drivers/Kconfig"

endmenu
