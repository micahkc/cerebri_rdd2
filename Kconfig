source "Kconfig.zephyr"

config TOP_SHELL
    bool "Enable top-like screen in shell"
    depends on SHELL
    default y

config PWM_FREQUENCY
    int "PWM motors frequency in Hz"
    depends on PWM
    default 400

config RDD2_PWM_FIRST_CHANNEL
    int "PWM channel number of the first motor output"
    depends on PWM
    range 0 1
    default 0
    help
      Motor N is driven on PWM channel N plus this offset. Controllers
      with zero-based channels (native_sim) use 0; STM32 timers number
      their channels from 1.
    
menu "RDD2"

rsource "subsys/Kconfig"
rsource "drivers/Kconfig"

endmenu
