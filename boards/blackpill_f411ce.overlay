/* SPDX-License-Identifier: Apache-2.0
 *
 * Micro-quad carrier for the WeAct Black Pill F411CE (schematic rev 3,
 * verified against the traced KiCad netlist 2026-08-11).
 *
 * BMI270 on SPI1, ESP32-C3 WiFi bridge on USART2, four brushed DC motors
 * through two DRV8833 H-bridges spanning TIM3/TIM2/TIM1, shared NSLEEP on
 * PA8, shared open-drain FAULT on PA1, battery divider on PB0.
 *
 * This overlay is the single place that says WHICH sensors/actuators are
 * connected and WHERE. The application only consumes the aliases below;
 * driver enablement and tuning live in blackpill_f411ce.conf.
 *
 * Pin budget:
 *   PA4  SPI1 CS      - BMI270 chip select (GPIO, active low)
 *   PA5/PA6/PA7 SPI1  - BMI270 SCK/MISO/MOSI
 *   PB10 EXTI         - BMI270 INT1 (data-ready, paces the rate loop)
 *   PB5  TIM3_CH2     - M1 PWM (U4 IN4)   PB4  GPIO low - companion (U4 IN3)
 *   PB3  TIM2_CH2     - M2 PWM (U4 IN2)   PB1  GPIO low - companion (U4 IN1)
 *   PB15 TIM1_CH3N    - M3 PWM (U5 IN4)   PB14 GPIO low - companion (U5 IN3)
 *   PB13 TIM1_CH1N    - M4 PWM (U5 IN2)   PB12 GPIO low - companion (U5 IN1)
 *   PA8  GPIO         - DRV8833 NSLEEP (both drivers)
 *   PA1  GPIO in      - DRV8833 FAULT (open drain, 10k pull-up)
 *   PB0  ADC1_IN8     - battery divider (100k / 100k, filtered)
 *   PA2/PA3 USART2    - ESP32-C3 WiFi bridge (synapse serial at 921600)
 *   PA9/PA10 USART1   - console/shell (on the module's own header)
 *   PA11/PA12 USB     - free (module USB-C usable)
 *   PB2  BOOT1        - unused (kept clear of the motor bank)
 *   PB6/PB7 I2C1      - free, labeled SCL/SDA for expansion
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pwm/stm32_pwm.h>

/ {
	aliases {
		imu0 = &bmi270;
		rc = &synapse_rc0;
		motors = &quad_motors;
		vbat = &vbat_divider;
		zros-serial = &usart2;
		/* no gnss: indoor micro quad, fix injectable over telemetry */
	};

	/* RC arrives as ManualControl frames on the same synapse serial link
	 * that carries telemetry (CONFIG_RDD2_RC_SYNAPSE); this virtual
	 * device is what rc_input.c listens to. */
	synapse_rc0: synapse_rc {
		compatible = "cognipilot,synapse-rc";
		status = "okay";
	};

	/* Mixer order m1..m4. 20 kHz keeps brushed drive above audible and
	 * gives ~4800 counts of resolution at the 96 MHz timer clock. The
	 * TIM1 outputs are on complementary CHxN pins, hence the flag. */
	quad_motors: quad_motors {
		compatible = "cognipilot,pwm-motors";
		pwms = <&motor_pwm3 2 PWM_KHZ(20) PWM_POLARITY_NORMAL>,
		       <&motor_pwm2 2 PWM_KHZ(20) PWM_POLARITY_NORMAL>,
		       <&motor_pwm1 3 PWM_KHZ(20) STM32_PWM_COMPLEMENTARY>,
		       <&motor_pwm1 1 PWM_KHZ(20) STM32_PWM_COMPLEMENTARY>;
		enable-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
		fault-gpios = <&gpioa 1 GPIO_ACTIVE_LOW>;
		/* H-bridge partner inputs, held physically low (fast decay). */
		companion-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>,
				  <&gpiob 1 GPIO_ACTIVE_HIGH>,
				  <&gpiob 14 GPIO_ACTIVE_HIGH>,
				  <&gpiob 12 GPIO_ACTIVE_HIGH>;
	};

	vbat_divider: vbat_divider {
		compatible = "voltage-divider";
		io-channels = <&adc1 8>;
		full-ohms = <200000>;
		output-ohms = <100000>;
	};
};

/* IMU: BMI270, SPI mode, CS as GPIO. The data-ready interrupt on PB5 paces
 * the control loop through the trigger backend (CONFIG_RDD2_IMU_TRIGGER). */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	bmi270: bmi270@0 {
		compatible = "bosch,bmi270";
		reg = <0>;
		spi-max-frequency = <8000000>;
		irq-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
	};
};

&timers3 {
	status = "okay";
	st,prescaler = <0>;

	motor_pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pb5>;
		pinctrl-names = "default";
	};
};

&timers2 {
	status = "okay";
	st,prescaler = <0>;

	motor_pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch2_pb3>;
		pinctrl-names = "default";
	};
};

&timers1 {
	status = "okay";
	st,prescaler = <0>;

	motor_pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1n_pb13 &tim1_ch3n_pb15>;
		pinctrl-names = "default";
	};
};

&adc1 {
	status = "okay";
	pinctrl-0 = <&adc1_in8_pb0>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/* The ESP32-C3 WiFi bridge on USART2 carries the synapse serial framing
 * both ways: telemetry topics out, ManualControl (RC) and injected fixes
 * in. The ESP32 is a transparent UART<->UDP bridge and never parses this. */
&usart2 {
	status = "okay";
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <921600>;
};
